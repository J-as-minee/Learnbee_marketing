# Public site URL (used by metadata)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Anthropic — powers the Help Centre's "Ask Learnbee AI" chat (app/api/help/chat)
ANTHROPIC_API_KEY=

# Resend — transactional email (resend)
RESEND_API_KEY=

# Neon — serverless Postgres (@neondatabase/serverless)
DATABASE_URL=

# Upstash Redis (@upstash/redis)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Vercel Blob storage (@vercel/blob) — admin blog image uploads
BLOB_READ_WRITE_TOKEN=

# ─────────────────────────────────────────────
# Blog + mini-CMS (file-based; publishes via GitHub)
# ─────────────────────────────────────────────

# Admin login at /blog/blog-admin
BLOG_ADMIN_PASSWORD=

# Draft preview: /blog/<slug>?preview=<token>
BLOG_PREVIEW_TOKEN=

# Production publishing — commits posts to the repo Vercel deploys from.
# Fine-grained PAT with Contents: Read/Write + Metadata: Read on this repo.
GITHUB_TOKEN=
GITHUB_REPO=J-as-minee/Learnbee_marketing
GITHUB_BRANCH=main

# Draft autosave uses Upstash above (UPSTASH_REDIS_REST_*). Vercel KV naming
# (KV_REST_API_URL / KV_REST_API_TOKEN) is also accepted if you prefer it.

# Leave empty on Learnbee — no external image fallback origin.
BLOG_IMAGE_FALLBACK_ORIGIN=

# Optional — newsletter + lead form emails (add when Resend is set up)
NEWSLETTER_NOTIFY_EMAIL=
LEADS_NOTIFY_EMAIL=
NEWSLETTER_EMAIL_FROM="Learnbee <onboarding@resend.dev>"
LEADS_EMAIL_FROM="Learnbee <onboarding@resend.dev>"

# ─────────────────────────────────────────────
# Quick Create (/create) — value-first draft handoff to the app
# ─────────────────────────────────────────────

# Base URL for the platform's draft endpoint. One endpoint handles both JSON
# and multipart (file attached):  POST {base}/draft -> 201 { token }
# The platform allows CORS from https://learnbee.ai, https://www.learnbee.ai
# and, outside production, http://localhost:3000.
NEXT_PUBLIC_PLATFORM_API_URL=https://creator.learnbee.ai/api

# App origin for the sign-in redirect.
NEXT_PUBLIC_APP_URL=https://creator.learnbee.ai

# Cloudflare Turnstile site key — dash.cloudflare.com > Turnstile > Add site.
# OPTIONAL TODAY: api/draft performs no Turnstile verification, so this only
# gates the browser. Real abuse control is the platform's per-IP/global rate
# limits and file cap. Set it once the platform verifies the token.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
